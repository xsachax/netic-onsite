{
  "name": "netic-onsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/evals/run.ts",
    "eval:generate": "tsx src/evals/generate.ts",
    "eval:generated": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/evals/run-generated.ts",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/openai": "^4.0.47",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.79",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
